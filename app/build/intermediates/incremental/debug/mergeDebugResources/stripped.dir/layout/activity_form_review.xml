<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kertas_skor"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/kertas_skor"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Review lawan"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TARGET SUMMARY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/ivTargetAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Lawan"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTargetInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_placeholder"
                        android:gravity="center"
                        android:text="MF"
                        android:textColor="@color/putih"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTargetTeamName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Merpati FC"
                        android:textColor="@color/tinta"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargetMatchInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elang Muda 3 - 2 · 8 Okt"
                        android:textColor="@color/abu_teks"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RATING 1: SPORTIVITAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sportivitas"
                        android:textColor="@color/tinta"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRatingSportivitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/5"
                        android:textColor="@color/lapangan"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <RatingBar
                    android:id="@+id/rbSportivitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:numStars="5"
                    android:progressTint="@color/peluit"
                    android:rating="5"
                    android:secondaryProgressTint="@color/peluit"
                    android:stepSize="1" />

                <!-- RATING 2: KETEPATAN WAKTU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ketepatan waktu"
                        android:textColor="@color/tinta"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRatingKetepatan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/5"
                        android:textColor="@color/lapangan"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <RatingBar
                    android:id="@+id/rbKetepatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:numStars="5"
                    android:progressTint="@color/peluit"
                    android:rating="5"
                    android:secondaryProgressTint="@color/peluit"
                    android:stepSize="1" />

                <!-- RATING 3: SKILL SESUAI LEVEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Skill sesuai level"
                        android:textColor="@color/tinta"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRatingSkill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/5"
                        android:textColor="@color/lapangan"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <RatingBar
                    android:id="@+id/rbSkill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:numStars="5"
                    android:progressTint="@color/peluit"
                    android:rating="5"
                    android:secondaryProgressTint="@color/peluit"
                    android:stepSize="1" />
            </LinearLayout>

            <!-- CATATAN -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCatatanReview"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Catatan untuk tim lawan"
                app:boxBackgroundColor="@color/putih"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:counterEnabled="true"
                app:counterMaxLength="200">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCatatanReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLength="200"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LOCK WARNING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_terkunci"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Terkunci"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/abu_teks" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Setelah dikirim, review terkunci. Tidak bisa diedit atau dihapus."
                    android:textColor="@color/abu_teks"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kertas_skor"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKirimReview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Kirim review"
            android:textAllCaps="false"
            android:textColor="@color/putih"
            android:textStyle="bold"
            app:backgroundTint="@color/lapangan"
            app:cornerRadius="26dp" />
    </LinearLayout>
</LinearLayout>
