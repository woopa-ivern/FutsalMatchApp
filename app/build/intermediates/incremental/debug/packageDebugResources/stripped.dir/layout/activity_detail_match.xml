<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kertas_skor"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/kertas_skor"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Detail match"
        app:titleTextColor="@color/tinta" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SCOREBOARD CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_lapangan"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- HOME TEAM -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp">

                            <ImageView
                                android:id="@+id/ivHomeAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Home"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvHomeInitials"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_placeholder"
                                android:gravity="center"
                                android:text="EM"
                                android:textColor="@color/putih"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvHomeName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Elang Muda"
                            android:textColor="@color/putih"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SCORE -->
                    <TextView
                        android:id="@+id/tvScoreBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="3 - 2"
                        android:textColor="@color/putih"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <!-- AWAY TEAM -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp">

                            <ImageView
                                android:id="@+id/ivAwayAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Away"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvAwayInitials"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_placeholder"
                                android:gravity="center"
                                android:text="MF"
                                android:textColor="@color/putih"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvAwayName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Merpati FC"
                            android:textColor="@color/putih"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailMatchDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Kamis, 8 Okt 2026"
                    android:textColor="@color/rumput_muda"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Lokasi"
                        android:src="@drawable/ic_location"
                        app:tint="@color/rumput_muda" />

                    <TextView
                        android:id="@+id/tvDetailMatchLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Lapangan Pogot, Surabaya"
                        android:textColor="@color/rumput_muda"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STATE 1: BELUM DIREVIEW -->
            <LinearLayout
                android:id="@+id/cardBelumReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReviewTargetTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Review untuk Merpati FC"
                        android:textColor="@color/tinta"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_belum_review"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Belum direview"
                        android:textColor="@color/sedang_level"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nilai sportivitas, ketepatan waktu, dan skill sesuai level. Satu match hanya punya satu review."
                    android:textColor="@color/abu_teks"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBukaFormReview"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Isi review"
                    android:textAllCaps="false"
                    android:textColor="@color/putih"
                    android:textStyle="bold"
                    app:backgroundTint="@color/lapangan"
                    app:cornerRadius="25dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Terkunci"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/abu_teks" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Tidak bisa diedit atau dihapus setelah dikirim"
                        android:textColor="@color/abu_teks"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STATE 2: REVIEW TERKUNCI -->
            <LinearLayout
                android:id="@+id/cardSudahReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLockedReviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Review kamu untuk Garuda FC"
                    android:textColor="@color/tinta"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_terkunci"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Terkunci"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/abu_teks" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Review terkunci"
                        android:textColor="@color/abu_teks"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Sportivitas"
                    android:textColor="@color/abu_teks"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStarsSportivitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★★ (5/5)"
                    android:textColor="@color/peluit"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ketepatan waktu"
                    android:textColor="@color/abu_teks"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStarsKetepatan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★★ (5/5)"
                    android:textColor="@color/peluit"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Skill sesuai level"
                    android:textColor="@color/abu_teks"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStarsSkillMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★☆ (4/5)"
                    android:textColor="@color/peluit"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Catatan"
                    android:textColor="@color/abu_teks"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLockedCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Permainan cepat dan rapi."
                    android:textColor="@color/tinta"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLockedTanggal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dikirim 28 Sep 2026"
                    android:textColor="@color/abu_muda"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_rumput"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="Terkunci"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/lapangan_malam" />

                    <TextView
                        android:id="@+id/tvLockedFooterInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Review ini sudah masuk ke rating lawan."
                        android:textColor="@color/lapangan_malam"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
