<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_rounded"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMatchDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8 Okt 2026"
            android:textColor="@color/abu_teks"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMatchResultWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menang"
            android:textColor="@color/lapangan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Elang Muda 3 - 2 Merpati FC"
        android:textColor="@color/tinta"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="Lokasi"
            android:src="@drawable/ic_location"
            app:tint="@color/abu_teks" />

        <TextView
            android:id="@+id/tvMatchLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lapangan Pogot"
            android:textColor="@color/abu_teks"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvReviewStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_belum_review"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Belum direview"
            android:textColor="@color/sedang_level"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
